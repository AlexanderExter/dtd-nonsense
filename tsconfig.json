{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "types": [
            "bun"
        ],
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "moduleDetection": "force",
        "noFallthroughCasesInSwitch": true
    }
}

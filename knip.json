{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"src/pages/**/*.astro",
		"src/content.config.ts",
		"scripts/*.{ts,mjs}",
		"astro.config.mjs"
	],
	"project": ["src/**/*.{ts,tsx,astro}", "scripts/**/*.{ts,mjs}"],
	"ignore": ["src/lib/dtd/schemas/**", "src/components/react/ui/*.tsx"],
	"ignoreDependencies": ["@astrojs/check", "react-hook-form"]
}

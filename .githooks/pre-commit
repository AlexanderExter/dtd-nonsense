#!/bin/sh
# Pre-commit hook: runs full verification before allowing a commit.
# Skippable with: git commit --no-verify
#
# Install: git config core.hooksPath .githooks
# (automated via bun run prepare)

echo "Pre-commit: running bun run check..."
bun run check

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit check FAILED. Commit blocked."
    echo "   Fix the issues above, or use --no-verify to skip."
    exit 1
fi

echo "✅ Pre-commit check passed."

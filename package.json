{
  "name": "dtd-rulebook",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prebuild": "bun run scripts/prebuild.mjs",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:coverage:lcov": "bun test --coverage --coverage-reporter=lcov",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "validate": "bun run scripts/validate.ts",
    "validate:xref": "bun run scripts/validate.ts --xref",
    "lint:data": "bun run scripts/lint.ts",
    "lint:md": "rumdl check .",
    "sync-check": "bun run scripts/sync-check.ts",
    "check": "bun test && biome check . && bun run scripts/validate.ts --xref && bun run scripts/lint.ts && bun run scripts/sync-check.ts && knip && bun run check:deps && bun run check:structure",
    "session:start": "bun run scripts/session-start.mjs",
    "session:end": "bun run scripts/session-end.mjs",
    "session:status": "bun run scripts/session-status.mjs",
    "upgrade:recon": "bun run scripts/upgrade-recon.mjs",
    "maintenance:recon": "node scripts/maintenance-recon.mjs",
    "knip": "knip",
    "check:deps": "depcruise --validate --output-type err src/components src/lib src/hooks scripts/",
    "check:structure": "bun run scripts/check-structure.ts",
    "prepare": "git config core.hooksPath .githooks",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/starlight": "^0.39.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.3.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/vercel": "^10.0.6",
    "@biomejs/biome": "2.4.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^17.4.0",
    "jsdom": "^29.1.1",
    "knip": "^6.13.1",
    "rumdl": "^0.1.91",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.7.0"
  },
  "overrides": {
    "path-to-regexp": "^8.0.0"
  },
  "_comments": {
    "overrides": "path-to-regexp: fixes ReDoS in @vercel/routing-utils@5.3.3 (via @astrojs/vercel@10). Remove when @vercel/routing-utils ships path-to-regexp ^8 natively."
  }
}

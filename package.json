{
	"name": "dtd-rulebook",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"prebuild": "bun run scripts/prebuild.mjs",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"validate": "bun run scripts/validate.ts",
		"validate:xref": "bun run scripts/validate.ts --xref",
		"lint:data": "bun run scripts/lint.ts",
		"lint:md": "rumdl check .",
		"sync-check": "bun run scripts/sync-check.ts",
		"check": "bun test && biome check . && bun run scripts/validate.ts --xref && bun run scripts/lint.ts",
		"session:start": "bun run scripts/session-start.mjs",
		"session:end": "bun run scripts/session-end.mjs",
		"session:status": "bun run scripts/session-status.mjs",
		"upgrade:recon": "bun run scripts/upgrade-recon.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/preact": "^4.1.3",
		"@astrojs/starlight": "^0.37.7",
		"@astrojs/starlight-tailwind": "^4.0.2",
		"@preact/signals": "^2.8.2",
		"@tailwindcss/vite": "^4.2.1",
		"@vercel/analytics": "^1.6.1",
		"astro": "^5.18.0",
		"chart.js": "^4.5.1",
		"gray-matter": "^4.0.3",
		"preact": "^10.28.4",
		"tailwindcss": "^4.2.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@astrojs/vercel": "^9.0.4",
		"@biomejs/biome": "2.4.6",
		"@types/bun": "^1.3.10",
		"rumdl": "^0.1.45",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"@vercel/routing-utils": {
			"path-to-regexp": "^8.0.0"
		},
		"svgo": "^4.0.1"
	},
	"_comments": {
		"overrides": "path-to-regexp: fixes ReDoS in @vercel/routing-utils (via @astrojs/vercel). @vercel/routing-utils@5.3.3 ships path-to-regexp@6.1.0; remove when routing-utils ships ^8 natively. svgo: force 4.0.1+ to patch DoS via DOCTYPE entity expansion (GHSA-xpqw-6gx7-v673, introduced by astro@5.18); remove when astro ships svgo@4.0.1+."
	}
}

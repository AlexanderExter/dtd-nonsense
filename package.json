{
  "name": "dtd-rulebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "prebuild": "bun run scripts/prebuild.mjs",
    "build": "astro build",
    "check": "bun test && biome check . && bun run scripts/validate.ts --xref && bun run scripts/lint.ts && bun run scripts/sync-check.ts && knip && bun run check:deps && bun run check:structure",
    "check:deps": "depcruise --validate --output-type err src/components src/lib src/hooks scripts/",
    "check:structure": "bun run scripts/check-structure.ts",
    "dev": "astro dev",
    "knip": "knip",
    "lint": "biome check .",
    "lint:data": "bun run scripts/lint.ts",
    "lint:fix": "biome check --write .",
    "lint:md": "rumdl check .",
    "maintenance:recon": "node scripts/maintenance-recon.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "preview": "astro preview",
    "session:end": "bun run scripts/session-end.mjs",
    "session:start": "bun run scripts/session-start.mjs",
    "session:status": "bun run scripts/session-status.mjs",
    "sync-check": "bun run scripts/sync-check.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:lcov": "bun test --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --watch",
    "upgrade:recon": "bun run scripts/upgrade-recon.mjs",
    "validate": "bun run scripts/validate.ts",
    "validate:xref": "bun run scripts/validate.ts --xref"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/starlight": "^0.42.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "immer": "^11.1.21",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vercel": "^11.0.11",
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "knip": "^6.39.0",
    "rumdl": "^0.2.78",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.12.3"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "_comments": {
    "overrides": "path-to-regexp: pins the ReDoS-patched 6.3.0 (CVE-2024-45296) for @vercel/routing-utils, which declares 6.1.0. Must stay on v6: v8 rejects the (.*) route patterns the Vercel adapter generates. Remove once routing-utils depends on >=6.3.0."
  }
}

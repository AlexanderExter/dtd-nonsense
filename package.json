{
    "name": "dtd-rulebook",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "prebuild": "node scripts/prebuild.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "validate": "bun run scripts/validate.ts",
        "validate:xref": "bun run scripts/validate.ts --xref",
        "lint:data": "bun run scripts/lint.ts",
        "sync-check": "bun run scripts/sync-check.ts",
        "check": "vitest run && biome check . && bun run scripts/validate.ts --xref && bun run scripts/lint.ts",
        "session:start": "node scripts/session-start.mjs",
        "session:end": "node scripts/session-end.mjs",
        "session:status": "node scripts/session-status.mjs",
        "prepare": "git config core.hooksPath .githooks",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/starlight": "^0.32.0",
        "@vercel/analytics": "^1.6.1",
        "astro": "^5.3.0",
        "chart.js": "^4.4.0",
        "gray-matter": "^4.0.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@astrojs/vercel": "^8.0.4",
        "@biomejs/biome": "2.4.5",
        "typescript": "^5.9.3",
        "vitest": "4.0.18"
    },
    "overrides": {
        "@vercel/routing-utils": {
            "path-to-regexp": "^8.0.0"
        }
    },
    "_comments": {
        "overrides": "path-to-regexp override fixes ReDoS vulnerability in @vercel/routing-utils via @astrojs/vercel. Re-evaluate when @astrojs/vercel upgrades past 8.2.x."
    }
}

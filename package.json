{
	"name": "dtd-rulebook",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"prebuild": "bun run scripts/prebuild.mjs",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"validate": "bun run scripts/validate.ts",
		"validate:xref": "bun run scripts/validate.ts --xref",
		"lint:data": "bun run scripts/lint.ts",
		"lint:md": "rumdl check .",
		"sync-check": "bun run scripts/sync-check.ts",
		"check": "bun test && biome check . && bun run scripts/validate.ts --xref && bun run scripts/lint.ts && bun run scripts/sync-check.ts && knip",
		"session:start": "bun run scripts/session-start.mjs",
		"session:end": "bun run scripts/session-end.mjs",
		"session:status": "bun run scripts/session-status.mjs",
		"upgrade:recon": "bun run scripts/upgrade-recon.mjs",
		"knip": "knip",
		"prepare": "git config core.hooksPath .githooks",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/react": "^4.3.1",
		"@astrojs/starlight": "^0.37.7",
		"@astrojs/starlight-tailwind": "^4.0.2",
		"@tailwindcss/vite": "^4.2.1",
		"@vercel/analytics": "^1.6.1",
		"astro": "^5.18.0",
		"gray-matter": "^4.0.3",
		"radix-ui": "^1.4.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.71.2",
		"tailwindcss": "^4.2.1",
		"zod": "^3.25.76",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"@astrojs/vercel": "^9.0.4",
		"@biomejs/biome": "2.4.6",
		"@types/bun": "^1.3.10",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"knip": "^5.86.0",
		"rumdl": "^0.1.45",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"path-to-regexp": "^8.0.0",
		"svgo": "^4.0.1"
	},
	"_comments": {
		"overrides": "path-to-regexp: fixes ReDoS in @vercel/routing-utils (via @astrojs/vercel). Flattened (not nested) because Bun does not support nested overrides. Remove when @vercel/routing-utils ships path-to-regexp ^8 natively. svgo: force 4.0.1+ to patch DoS via DOCTYPE entity expansion (GHSA-xpqw-6gx7-v673, introduced by astro@5.18); remove when astro ships svgo@4.0.1+."
	}
}

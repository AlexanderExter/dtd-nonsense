---
import ToolLayout from "@/layouts/ToolLayout.astro";
---

<ToolLayout title="Play Tools" description="Web-based play aids for Dungeons the Dragoning 40,000">
  <header class="text-center pt-12 px-md pb-md border-b border-border">
    <h1 class="m-0 text-[2.5rem] text-accent">Dungeons the Dragoning</h1>
    <p class="mt-sm mb-0 text-text-muted">40,000: 7th Edition — Player Tools</p>
  </header>

  <main class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-lg p-xl max-w-[1200px] mx-auto">
    <a href="/tools/character-sheet/" class="tool-card">
      <h2>Character Sheet</h2>
      <p>Freeform character sheet for creation and play. Edit all sections freely, auto-calculated derived stats, multiple character slots, and JSON import/export.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/character-builder/" class="tool-card">
      <h2>Character Builder</h2>
      <p>Guided 11-step character creation wizard with priority-based allocation, XP tracking, and JSON export.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/dice-roller/" class="tool-card">
      <h2>Dice Roller</h2>
      <p>Roll XkY dice pools with exploding d10s, overflow compression, and automatic Raise/Check calculation. Supports modifiers and roll history.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/quick-reference/" class="tool-card">
      <h2>Quick Reference</h2>
      <p>Searchable index of conditions, action types, combat modifiers, and common rules. Find what you need fast during play.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/npc-generator/" class="tool-card">
      <h2>NPC Stat Block Builder</h2>
      <p>Build NPC stat blocks with auto-calculated derived stats, trait modifiers, and 40+ templates from the core rules. Save, print, and copy as Markdown.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/combat-tracker/" class="tool-card">
      <h2>Combat Tracker</h2>
      <p>Initiative order management, HP and resource tracking, condition toggles. Keep your battles organized.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/ship-builder/" class="tool-card">
      <h2>Ship Builder</h2>
      <p>Build and customize spelljammer ships with hull selection, consoles, weapons, shields, and crew. Includes a Sheet mode for tracking combat.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/success-curves/" class="tool-card">
      <h2>Success Curve Analyzer</h2>
      <p>Visualize XkY probability distributions against Target Numbers. Compare up to 4 dice pools via Monte Carlo simulation.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>

    <a href="/tools/defense-graph/" class="tool-card">
      <h2>Defense Graph Simulator</h2>
      <p>Visualize how damage mitigation evolves across the defense pipeline. See how armor, penetration, aura, cover, and resilience interact.</p>
      <span class="tool-badge-ready">Ready</span>
    </a>
  </main>

  <footer class="text-center p-md text-text-muted text-[0.85rem]">
    Data extracted from <em>Dungeons the Dragoning 40,000: 7th Edition</em> and <em>For a Few Subtitles More</em>.<br />
    This is a fan-made tool. All content belongs to its respective creators.
  </footer>

  <style>
    .tool-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--spacing-lg);
      text-decoration: none;
      color: var(--color-text-primary);
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .tool-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px var(--color-shadow);
      border-color: var(--color-accent);
      color: var(--color-text-primary);
    }
    .tool-card h2 {
      margin: 0 0 var(--spacing-sm) 0;
      color: var(--color-accent);
      font-size: 1.25rem;
    }
    .tool-card p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .tool-badge-ready {
      display: inline-block;
      margin-top: var(--spacing-md);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      background: var(--color-success-bg);
      color: var(--color-success);
    }
  </style>
</ToolLayout>

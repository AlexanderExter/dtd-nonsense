---
import ToolLayout from "@/layouts/ToolLayout.astro";
---

<ToolLayout title="Success Curve Analyzer" description="Visualize XkY probability distributions via Monte Carlo simulation against Target Numbers.">
  <!-- Input Panel -->
  <section class="input-panel no-print" aria-label="Dice pool configuration">
    <div id="pool-rows">
      <div class="pool-row" data-pool="0">
        <span class="pool-color-swatch" data-pool="0"></span>
        <label class="pool-field">
          <span class="field-label">Rolled</span>
          <input type="range" class="pool-slider" data-param="numDice" min="1" max="15" value="5" />
          <input type="number" class="pool-input" data-param="numDice" min="1" max="15" value="5" />
        </label>
        <span class="k-separator">k</span>
        <label class="pool-field">
          <span class="field-label">Kept</span>
          <input type="range" class="pool-slider" data-param="keepDice" min="1" max="10" value="3" />
          <input type="number" class="pool-input" data-param="keepDice" min="1" max="10" value="3" />
        </label>
        <label class="pool-field pool-field-narrow">
          <span class="field-label">Mod</span>
          <input type="number" class="pool-input" data-param="modifier" min="-10" max="30" value="0" />
        </label>
      </div>
    </div>

    <div class="tn-row">
      <label class="pool-field tn-field">
        <span class="field-label">Target Number</span>
        <input type="range" id="tn-slider" min="5" max="50" value="15" step="1" />
        <input type="number" id="tn-input" min="5" max="50" value="15" />
      </label>
      <span id="tn-label" class="tn-difficulty">Average</span>
    </div>

    <div class="controls-row">
      <div class="preset-group">
        <span class="field-label">Presets</span>
        <div class="preset-buttons">
          <button class="btn btn-ghost preset-btn" data-pool="2,2">2k2</button>
          <button class="btn btn-ghost preset-btn" data-pool="3,2">3k2</button>
          <button class="btn btn-ghost preset-btn" data-pool="3,3">3k3</button>
          <button class="btn btn-ghost preset-btn" data-pool="5,3">5k3</button>
          <button class="btn btn-ghost preset-btn" data-pool="5,5">5k5</button>
          <button class="btn btn-ghost preset-btn" data-pool="7,4">7k4</button>
          <button class="btn btn-ghost preset-btn" data-pool="8,4">8k4</button>
          <button class="btn btn-ghost preset-btn" data-pool="10,5">10k5</button>
          <button class="btn btn-ghost preset-btn" data-pool="10,10">10k10</button>
        </div>
      </div>
      <div class="stunt-group">
        <span class="field-label">Stunt</span>
        <div class="stunt-buttons">
          <button class="btn btn-ghost stunt-btn" data-stunt="1">+1</button>
          <button class="btn btn-ghost stunt-btn" data-stunt="2">+2</button>
          <button class="btn btn-ghost stunt-btn" data-stunt="3">+3</button>
        </div>
      </div>
      <div class="helper-group">
        <span class="field-label">Skill Test Helper</span>
        <div class="helper-inputs">
          <label>
            Skill
            <input type="number" id="helper-skill" min="0" max="6" value="0" />
          </label>
          <span class="text-muted">+</span>
          <label>
            Char
            <input type="number" id="helper-char" min="1" max="6" value="1" />
          </label>
          <button class="btn btn-secondary" id="helper-apply">Apply</button>
        </div>
      </div>
    </div>

    <div class="pool-actions">
      <button class="btn btn-secondary" id="add-pool-btn">+ Add Pool</button>
      <button class="btn btn-ghost" id="clear-all-btn">Clear All</button>
      <button class="btn btn-ghost" id="share-btn" title="Copy shareable URL">Share</button>
    </div>
  </section>

  <!-- Graphs Grid -->
  <main class="graphs-grid">
    <div class="card graph-card">
      <div class="card-header"><h3>Success Probability vs TN</h3></div>
      <div class="chart-wrap"><canvas id="chart-success"></canvas></div>
    </div>
    <div class="card graph-card">
      <div class="card-header"><h3>Result Distribution</h3></div>
      <div class="chart-wrap"><canvas id="chart-histogram"></canvas></div>
    </div>
    <div class="card graph-card">
      <div class="card-header"><h3>Raise / Check Distribution</h3></div>
      <div class="chart-wrap"><canvas id="chart-raises"></canvas></div>
    </div>
    <div class="card graph-card stats-card">
      <div class="card-header"><h3>Statistics</h3></div>
      <div class="table-wrap">
        <table id="stats-table">
          <thead>
            <tr>
              <th>Pool</th><th>Mean</th><th>Median</th><th>Std Dev</th>
              <th>P(≥TN)</th><th>P(≥TN+5)</th><th>P(≥TN+10)</th><th>E[Raises]</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    // Dynamic Chart.js import (bundled by Vite, no CDN)
    const { Chart, registerables } = await import("chart.js");
    Chart.register(...registerables);

    // =====================================================================
    // Constants
    // =====================================================================

    const POOL_COLORS = ["#d4a84b", "#60a5fa", "#4ade80", "#f87171"];
    const MAX_POOLS = 4;
    const TRIALS = 100_000;
    const TN_MIN = 5;
    const TN_MAX = 50;
    const TN_STEP = 1;
    const DEBOUNCE_MS = 300;
    const CACHE_MAX = 20;

    const TN_LABELS: Record<number, string> = {
      5: "Mundane",
      10: "Easy",
      15: "Average",
      20: "Hard",
      25: "Very Hard",
      30: "Heroic",
      35: "Never Done Before",
      40: "Never to be Done Again",
    };

    const RAISE_CHECK_LABELS = [
      "3+ Checks", "2 Checks", "1 Check / Near Miss",
      "Success (0 Raises)", "1 Raise", "2 Raises", "3+ Raises",
    ];

    const RAISE_CHECK_COLORS = [
      "#dc2626", "#f87171", "#fbbf24", "#4ade80", "#22d3ee", "#818cf8", "#c084fc",
    ];

    // =====================================================================
    // State
    // =====================================================================

    let pools = [{ numDice: 5, keepDice: 3, modifier: 0 }];
    let selectedTN = 15;
    let activeStunt = 0;
    let worker: Worker | null = null;
    window.addEventListener('beforeunload', () => worker?.terminate());
    const cache = new Map<string, any>();
    let pendingJobs = 0;
    let jobIdCounter = 0;
    const pendingCallbacks = new Map<number, (data: any) => void>();
    let chartSuccess: InstanceType<typeof Chart> | null = null;
    let chartHistogram: InstanceType<typeof Chart> | null = null;
    let chartRaises: InstanceType<typeof Chart> | null = null;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;
    const results = new Map<number, any>();

    // =====================================================================
    // Worker Management
    // =====================================================================

    function initWorker() {
      worker = new Worker("/workers/simulation-worker.js");
      worker.onmessage = (e) => {
        const { id } = e.data;
        const cb = pendingCallbacks.get(id);
        if (cb) {
          pendingCallbacks.delete(id);
          cb(e.data);
        }
        pendingJobs--;
        if (pendingJobs === 0) renderAll();
      };
      worker.onerror = (err) => console.error("Simulation worker error:", err);
    }

    function simulate(poolIndex: number, pool: { numDice: number; keepDice: number; modifier: number }) {
      const key = `${pool.numDice}k${pool.keepDice}+${pool.modifier}`;
      const cached = cache.get(key);
      if (cached) {
        results.set(poolIndex, cached);
        pendingJobs--;
        if (pendingJobs === 0) renderAll();
        return;
      }
      const id = ++jobIdCounter;
      pendingCallbacks.set(id, (data) => {
        cache.set(key, data);
        if (cache.size > CACHE_MAX) {
          const firstKey = cache.keys().next().value;
          if (firstKey !== undefined) cache.delete(firstKey);
        }
        results.set(poolIndex, data);
      });
      worker!.postMessage({
        id, numDice: pool.numDice, keepDice: pool.keepDice, modifier: pool.modifier,
        trials: TRIALS, tnMin: TN_MIN, tnMax: TN_MAX, tnStep: TN_STEP, selectedTN,
      });
    }

    function runAllSimulations() {
      results.clear();
      pendingJobs = pools.length;
      pools.forEach((pool, i) => simulate(i, pool));
    }

    // =====================================================================
    // Chart.js Plugins
    // =====================================================================

    const tnLinePlugin = {
      id: "tnLine",
      afterDraw(chart: InstanceType<typeof Chart>) {
        if (chart.canvas.id !== "chart-histogram") return;
        const xScale = chart.scales.x, yScale = chart.scales.y;
        if (!xScale || !yScale) return;
        const labels = chart.data.labels as number[];
        const tnIdx = labels.indexOf(selectedTN);
        if (tnIdx === -1) return;
        const x = xScale.getPixelForValue(tnIdx);
        const ctx = chart.ctx;
        ctx.save(); ctx.beginPath(); ctx.setLineDash([6, 4]); ctx.lineWidth = 2;
        ctx.strokeStyle = "#f87171"; ctx.moveTo(x, yScale.top); ctx.lineTo(x, yScale.bottom); ctx.stroke();
        ctx.fillStyle = "#f87171"; ctx.font = "bold 11px system-ui"; ctx.textAlign = "center";
        ctx.fillText(`TN ${selectedTN}`, x, yScale.top - 6); ctx.restore();
      },
    };

    const fiftyLinePlugin = {
      id: "fiftyLine",
      afterDraw(chart: InstanceType<typeof Chart>) {
        if (chart.canvas.id !== "chart-success") return;
        const yScale = chart.scales.y;
        if (!yScale) return;
        const y = yScale.getPixelForValue(50);
        const ctx = chart.ctx;
        ctx.save(); ctx.beginPath(); ctx.setLineDash([4, 4]); ctx.lineWidth = 1;
        ctx.strokeStyle = "#6c6a75"; ctx.moveTo(chart.chartArea.left, y); ctx.lineTo(chart.chartArea.right, y); ctx.stroke();
        ctx.fillStyle = "#6c6a75"; ctx.font = "10px system-ui"; ctx.textAlign = "right";
        ctx.fillText("50%", chart.chartArea.left - 4, y + 3); ctx.restore();
      },
    };

    const selectedTNPlugin = {
      id: "selectedTN",
      afterDraw(chart: InstanceType<typeof Chart>) {
        if (chart.canvas.id !== "chart-success") return;
        const xScale = chart.scales.x, yScale = chart.scales.y;
        if (!xScale || !yScale) return;
        const labels = chart.data.labels as number[];
        const idx = labels.indexOf(selectedTN);
        if (idx === -1) return;
        const x = xScale.getPixelForValue(idx);
        const ctx = chart.ctx;
        ctx.save(); ctx.beginPath(); ctx.setLineDash([6, 4]); ctx.lineWidth = 2;
        ctx.strokeStyle = "#d4a84b88"; ctx.moveTo(x, yScale.top); ctx.lineTo(x, yScale.bottom); ctx.stroke();
        ctx.fillStyle = "#d4a84b"; ctx.font = "bold 11px system-ui"; ctx.textAlign = "center";
        ctx.fillText(`TN ${selectedTN}`, x, yScale.bottom + 16); ctx.restore();
      },
    };

    // =====================================================================
    // Chart rendering
    // =====================================================================

    function initCharts() {
      Chart.defaults.color = "#94929d";
      Chart.defaults.borderColor = "#2a2a32";
      Chart.register(tnLinePlugin, fiftyLinePlugin, selectedTNPlugin);

      chartSuccess = new Chart(
        (document.getElementById("chart-success") as HTMLCanvasElement).getContext("2d")!,
        {
          type: "line", data: { labels: [], datasets: [] },
          options: {
            responsive: true, maintainAspectRatio: false,
            interaction: { mode: "index", intersect: false },
            onClick: (_evt: any, elements: any, chart: any) => {
              if (elements.length > 0) {
                const tn = (chart.data.labels as number[])[elements[0].index];
                setTN(tn);
              }
            },
            plugins: {
              tooltip: { callbacks: { label: (ctx: any) => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}%` } },
              legend: { display: true, position: "bottom" },
            },
            scales: {
              x: { title: { display: true, text: "Target Number" }, grid: { color: "#1e1e24" } },
              y: { title: { display: true, text: "P(Success) %" }, min: 0, max: 100, grid: { color: "#1e1e24" } },
            },
          },
        }
      );

      chartHistogram = new Chart(
        (document.getElementById("chart-histogram") as HTMLCanvasElement).getContext("2d")!,
        {
          type: "bar", data: { labels: [], datasets: [] },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
              tooltip: { callbacks: { label: (ctx: any) => `${ctx.parsed.y.toFixed(2)}%` } },
              legend: { display: true, position: "bottom" },
            },
            scales: {
              x: { title: { display: true, text: "Roll Total" }, grid: { display: false },
                ticks: { maxTicksLimit: 20, callback: (value: any) => (Number(value) % 5 === 0 ? value : "") } },
              y: { title: { display: true, text: "Probability %" }, min: 0, grid: { color: "#1e1e24" } },
            },
          },
        }
      );

      chartRaises = new Chart(
        (document.getElementById("chart-raises") as HTMLCanvasElement).getContext("2d")!,
        {
          type: "bar", data: { labels: RAISE_CHECK_LABELS, datasets: [] },
          options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
              tooltip: { callbacks: { label: (ctx: any) => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(1)}%` } },
              legend: { display: true, position: "bottom" },
            },
            scales: {
              x: { grid: { display: false } },
              y: { title: { display: true, text: "Probability %" }, min: 0, grid: { color: "#1e1e24" } },
            },
          },
        }
      );
    }

    function renderAll() { renderSuccessChart(); renderHistogramChart(); renderRaisesChart(); renderStatsTable(); }

    function renderSuccessChart() {
      const tnLabels: number[] = [];
      for (let tn = TN_MIN; tn <= TN_MAX; tn += TN_STEP) tnLabels.push(tn);
      const datasets = pools.map((_, i) => {
        const data = results.get(i);
        if (!data) return null;
        return {
          label: poolLabel(i), data: tnLabels.map((tn) => data.successRates[tn] ?? 0),
          borderColor: POOL_COLORS[i], backgroundColor: POOL_COLORS[i] + "33",
          borderWidth: 2, pointRadius: 0, pointHoverRadius: 5, tension: 0.25, fill: false,
        };
      }).filter(Boolean);
      chartSuccess!.data.labels = tnLabels;
      chartSuccess!.data.datasets = datasets as any;
      chartSuccess!.update("none");
    }

    function renderHistogramChart() {
      let maxLen = 0;
      pools.forEach((_, i) => { const d = results.get(i); if (d && d.histogram.length > maxLen) maxLen = d.histogram.length; });
      if (maxLen === 0) return;
      const labels: number[] = []; for (let i = 0; i < maxLen; i++) labels.push(i);
      const datasets = pools.map((_, i) => {
        const data = results.get(i); if (!data) return null;
        const padded = new Array(maxLen).fill(0);
        for (let j = 0; j < data.histogram.length; j++) padded[j] = data.histogram[j];
        return {
          label: poolLabel(i), data: padded,
          backgroundColor: POOL_COLORS[i] + "88", borderColor: POOL_COLORS[i],
          borderWidth: 1, barPercentage: 1.0, categoryPercentage: 1.0,
        };
      }).filter(Boolean);
      chartHistogram!.data.labels = labels;
      chartHistogram!.data.datasets = datasets as any;
      chartHistogram!.update("none");
    }

    function renderRaisesChart() {
      const datasets = pools.map((_, i) => {
        const data = results.get(i); if (!data) return null;
        return { label: poolLabel(i), data: data.raiseChecks, backgroundColor: RAISE_CHECK_COLORS, borderColor: "#0d0d0f", borderWidth: 1 };
      }).filter(Boolean);
      chartRaises!.data.datasets = datasets as any;
      chartRaises!.update("none");
    }

    function renderStatsTable() {
      const tbody = document.querySelector("#stats-table tbody")!;
      tbody.innerHTML = "";
      pools.forEach((_, i) => {
        const data = results.get(i); if (!data) return;
        const row = document.createElement("tr");
        const pTN = data.successRates[selectedTN] ?? 0;
        const pTN5 = data.successRates[selectedTN + 5] ?? 0;
        const pTN10 = data.successRates[selectedTN + 10] ?? 0;
        let expRaises = 0;
        for (let r = 1; r <= 10; r++) { const rate = data.successRates[selectedTN + r * 5]; if (rate != null) expRaises += rate / 100; }
        row.innerHTML = `
          <td><span class="stats-pool-swatch" style="background:${POOL_COLORS[i]}"></span>${poolLabel(i)}</td>
          <td>${data.mean.toFixed(1)}</td><td>${data.median.toFixed(1)}</td><td>${data.stdDev.toFixed(1)}</td>
          <td>${pTN.toFixed(1)}%</td><td>${pTN5.toFixed(1)}%</td><td>${pTN10.toFixed(1)}%</td><td>${expRaises.toFixed(1)}</td>
        `;
        tbody.appendChild(row);
      });
    }

    // =====================================================================
    // Helpers
    // =====================================================================

    function poolLabel(index: number) {
      const p = pools[index]; if (!p) return "";
      const mod = p.modifier > 0 ? `+${p.modifier}` : p.modifier < 0 ? `${p.modifier}` : "";
      return `${p.numDice}k${p.keepDice}${mod}`;
    }

    function setTN(tn: number) {
      selectedTN = tn;
      (document.getElementById("tn-slider") as HTMLInputElement).value = String(tn);
      (document.getElementById("tn-input") as HTMLInputElement).value = String(tn);
      updateTNLabel(); scheduleSimulation();
    }

    function updateTNLabel() {
      const label = document.getElementById("tn-label")!;
      let best = "";
      for (const [tn, text] of Object.entries(TN_LABELS)) {
        if (selectedTN >= parseInt(tn, 10)) best = `${text} (TN ${tn})`;
      }
      label.textContent = best || `TN ${selectedTN}`;
    }

    // =====================================================================
    // UI Binding
    // =====================================================================

    function bindEvents() {
      document.getElementById("pool-rows")!.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const row = target.closest(".pool-row") as HTMLElement; if (!row) return;
        const poolIdx = parseInt(row.dataset.pool!, 10);
        const param = target.dataset.param as "numDice" | "keepDice" | "modifier"; if (!param) return;
        const val = parseInt(target.value, 10); if (isNaN(val)) return;
        pools[poolIdx][param] = val;
        if (param === "numDice" && pools[poolIdx].keepDice > val) pools[poolIdx].keepDice = val;
        syncPoolRow(row, poolIdx); scheduleSimulation();
      });

      const tnSlider = document.getElementById("tn-slider") as HTMLInputElement;
      const tnInput = document.getElementById("tn-input") as HTMLInputElement;
      tnSlider.addEventListener("input", () => {
        selectedTN = parseInt(tnSlider.value, 10); tnInput.value = String(selectedTN);
        updateTNLabel(); scheduleSimulation();
      });
      tnInput.addEventListener("input", () => {
        const v = parseInt(tnInput.value, 10);
        if (!isNaN(v) && v >= TN_MIN && v <= TN_MAX) { selectedTN = v; tnSlider.value = String(v); updateTNLabel(); scheduleSimulation(); }
      });

      document.querySelectorAll<HTMLButtonElement>(".preset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const [num, keep] = btn.dataset.pool!.split(",").map(Number);
          pools[0].numDice = num; pools[0].keepDice = keep; pools[0].modifier = 0;
          syncPoolRow(document.querySelector('.pool-row[data-pool="0"]')!, 0); scheduleSimulation();
        });
      });

      document.querySelectorAll<HTMLButtonElement>(".stunt-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const level = parseInt(btn.dataset.stunt!, 10);
          if (activeStunt === level) { activeStunt = 0; btn.classList.remove("active"); }
          else { activeStunt = level; document.querySelectorAll(".stunt-btn").forEach((b) => b.classList.remove("active")); btn.classList.add("active"); }
        });
      });

      document.getElementById("helper-apply")!.addEventListener("click", () => {
        const skill = parseInt((document.getElementById("helper-skill") as HTMLInputElement).value, 10) || 0;
        const char = parseInt((document.getElementById("helper-char") as HTMLInputElement).value, 10) || 1;
        pools[0].numDice = skill + char + activeStunt; pools[0].keepDice = char; pools[0].modifier = 0;
        syncPoolRow(document.querySelector('.pool-row[data-pool="0"]')!, 0); scheduleSimulation();
      });

      document.getElementById("add-pool-btn")!.addEventListener("click", () => {
        if (pools.length >= MAX_POOLS) { showToast(`Maximum ${MAX_POOLS} pools`); return; }
        pools.push({ numDice: 5, keepDice: 3, modifier: 0 }); rebuildPoolRows(); scheduleSimulation();
      });

      document.getElementById("clear-all-btn")!.addEventListener("click", () => {
        pools = [{ numDice: 5, keepDice: 3, modifier: 0 }]; activeStunt = 0;
        document.querySelectorAll(".stunt-btn").forEach((b) => b.classList.remove("active"));
        rebuildPoolRows(); scheduleSimulation();
      });

      document.getElementById("share-btn")!.addEventListener("click", shareURL);
    }

    function syncPoolRow(row: Element, poolIdx: number) {
      const pool = pools[poolIdx]; if (!pool) return;
      if (pool.keepDice > pool.numDice) pool.keepDice = pool.numDice;
      row.querySelectorAll<HTMLInputElement>("[data-param]").forEach((el) => {
        const param = el.dataset.param as keyof typeof pool;
        const val = pool[param];
        if (val != null && parseInt(el.value, 10) !== val) el.value = String(val);
        if (param === "keepDice") el.max = String(Math.min(pool.numDice, 10));
      });
    }

    // =====================================================================
    // Pool Row DOM
    // =====================================================================

    function rebuildPoolRows() {
      const container = document.getElementById("pool-rows")!;
      container.innerHTML = "";
      pools.forEach((pool, i) => container.appendChild(createPoolRow(i, pool)));
      updateAddButton();
    }

    function createPoolRow(index: number, pool: { numDice: number; keepDice: number; modifier: number }) {
      const row = document.createElement("div");
      row.className = "pool-row"; row.dataset.pool = String(index);
      row.innerHTML = `
        <span class="pool-color-swatch" style="background:${POOL_COLORS[index]}"></span>
        <label class="pool-field">
          <span class="field-label">Rolled</span>
          <input type="range" class="pool-slider" data-param="numDice" min="1" max="15" value="${pool.numDice}" />
          <input type="number" class="pool-input" data-param="numDice" min="1" max="15" value="${pool.numDice}" />
        </label>
        <span class="k-separator">k</span>
        <label class="pool-field">
          <span class="field-label">Kept</span>
          <input type="range" class="pool-slider" data-param="keepDice" min="1" max="${Math.min(pool.numDice, 10)}" value="${pool.keepDice}" />
          <input type="number" class="pool-input" data-param="keepDice" min="1" max="${Math.min(pool.numDice, 10)}" value="${pool.keepDice}" />
        </label>
        <label class="pool-field pool-field-narrow">
          <span class="field-label">Mod</span>
          <input type="number" class="pool-input" data-param="modifier" min="-10" max="30" value="${pool.modifier}" />
        </label>
        ${index > 0 ? `<button class="remove-pool-btn" data-remove="${index}" title="Remove pool">×</button>` : ""}
      `;
      const removeBtn = row.querySelector(".remove-pool-btn");
      if (removeBtn) removeBtn.addEventListener("click", () => { pools.splice(index, 1); rebuildPoolRows(); scheduleSimulation(); });
      return row;
    }

    function updateAddButton() {
      (document.getElementById("add-pool-btn") as HTMLButtonElement).disabled = pools.length >= MAX_POOLS;
    }

    // =====================================================================
    // Scheduling & URL Sharing
    // =====================================================================

    function scheduleSimulation() {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => runAllSimulations(), DEBOUNCE_MS);
    }

    function shareURL() {
      const params = pools.map((p) => `${p.numDice}k${p.keepDice}${p.modifier ? (p.modifier > 0 ? "+" : "") + p.modifier : ""}`);
      const hash = `#pools=${params.join(",")}&tn=${selectedTN}`;
      const url = window.location.href.split("#")[0] + hash;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => showToast("URL copied to clipboard"), () => showToast("URL updated in address bar"));
      }
      window.location.hash = hash.slice(1);
    }

    function loadFromURL() {
      const hash = window.location.hash.slice(1); if (!hash) return;
      const params = new URLSearchParams(hash);
      const poolStr = params.get("pools");
      const tnStr = params.get("tn");
      if (poolStr) {
        const parsed = poolStr.split(",").map((s) => {
          const m = s.trim().match(/^(\d+)k(\d+)([+-]\d+)?$/); if (!m) return null;
          return { numDice: parseInt(m[1], 10), keepDice: parseInt(m[2], 10), modifier: m[3] ? parseInt(m[3], 10) : 0 };
        }).filter(Boolean).slice(0, MAX_POOLS) as { numDice: number; keepDice: number; modifier: number }[];
        if (parsed.length > 0) pools = parsed;
      }
      if (tnStr) { const tn = parseInt(tnStr, 10); if (!isNaN(tn) && tn >= TN_MIN && tn <= TN_MAX) selectedTN = tn; }
    }

    // =====================================================================
    // Toast
    // =====================================================================

    let toastTimer: ReturnType<typeof setTimeout> | null = null;
    function showToast(message: string) {
      const el = document.getElementById("toast")!;
      el.textContent = message; el.classList.add("visible");
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("visible"), 2500);
    }

    // =====================================================================
    // Init
    // =====================================================================

    loadFromURL();
    initWorker();
    initCharts();
    rebuildPoolRows();
    (document.getElementById("tn-slider") as HTMLInputElement).value = String(selectedTN);
    (document.getElementById("tn-input") as HTMLInputElement).value = String(selectedTN);
    updateTNLabel();
    bindEvents();
    runAllSimulations();
  </script>

  <style>

---
import { QuickReferenceApp } from "@/components/react/tools/quick-reference/QuickReferenceApp";
import ToolLayout from "@/layouts/ToolLayout.astro";
---

<ToolLayout title="Quick Reference" description="Fast, searchable rules lookup for DTD 40k gameplay">
  <QuickReferenceApp client:only="react" />

  <style>
    @media print {
      .no-print { display: none !important; }
      mark { background: none; }
      body { font-size: 10pt; }
    }
  </style>
</ToolLayout>

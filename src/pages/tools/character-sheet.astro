import { CharacterSheetApp } from "@/components/react/tools/character-sheet/CharacterSheetApp";
import ToolLayout from "@/layouts/ToolLayout.astro";
---

<ToolLayout title="Character Sheet" description="Interactive digital character sheet with auto-calculations">
  <CharacterSheetApp client:only="react" />
  <style is:global>
  @media print {
      .no-print { display: none !important; }
      .save-status { display: none !important; }
      .tab-panel { display: block !important; page-break-before: always; }
      .tab-panel:first-child { page-break-before: avoid; }
      .tab-panel::before {
          display: block;
          padding-bottom: var(--space-sm);
          margin-bottom: var(--space-md);
          font-size: 1.2rem;
          font-weight: 700;
          color: var(--accent);
          content: attr(data-print-title);
          border-bottom: 2px solid var(--accent);
      }
      .section-card { break-inside: avoid; }
  }
  </style>
</ToolLayout>

---
import { CharacterSheetApp } from "@/components/preact/tools/character-sheet/CharacterSheetApp";
import ToolLayout from "@/layouts/ToolLayout.astro";
---

<ToolLayout title="Character Sheet" description="Interactive digital character sheet with auto-calculations">
    <CharacterSheetApp client:only="preact" />

    <style is:global>
    /* Print styles only - all visual styling is in Tailwind utilities */
    @media print {
        .no-print { display: none !important; }
        .save-status { display: none !important; }
        .tab-panel { display: block !important; page-break-before: always; }
        .tab-panel:first-child { page-break-before: avoid; }
        .tab-panel::before {
            content: attr(data-print-title);
            display: block;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: var(--space-md);
            border-bottom: 2px solid var(--accent);
            padding-bottom: var(--space-sm);
        }
        .section-card { break-inside: avoid; }
    }
    </style>
</ToolLayout>

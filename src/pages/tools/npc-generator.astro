    /* Input Panel */
    .input-panel {
      padding: var(--space-md) var(--space-lg);
      overflow-y: auto;
      max-height: calc(100vh - 50px);
      border-right: 1px solid var(--border);
    }

    .input-section {
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--border);
    }

    .input-section:last-child {
      border-bottom: none;
    }

    .section-title {
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--accent);
      margin: 0 0 var(--space-sm);
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-sm);
    }

    .section-header .section-title {
      margin: 0;
    }

    /* Core Fields */
    .core-fields {
      display: grid;
      grid-template-columns: 1fr 80px 80px 80px;
      gap: var(--space-sm);
      align-items: end;
    }

    .field label {
      font-size: 0.8rem;
      margin-bottom: 2px;
    }

    .field input,
    .field select {
      width: 100%;
      padding: var(--space-xs) var(--space-sm);
      font-size: 0.9rem;
    }

    .field-wide {
      grid-column: 1;
    }

    /* Characteristics Grid */
    .char-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-sm);
    }

    .char-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .char-cell label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .char-input {
      width: 60px;
      text-align: center;
      padding: var(--space-xs);
      font-size: 1rem;
      font-weight: 600;
    }

    /* Quick Add Row */
    .quick-add-row {
      display: flex;
      gap: var(--space-xs);
      margin-bottom: var(--space-sm);
      flex-wrap: wrap;
    }

    /* List Entries (skills, feats, armor, weapons, abilities) */
    .list-entries {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .list-entry {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-xs) var(--space-sm);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
    }

    .list-entry input,
    .list-entry select {
      padding: 2px var(--space-xs);
      font-size: 0.85rem;
    }

    .list-entry .entry-name {
      flex: 1;
      min-width: 0;
    }

    .list-entry .entry-dots {
      width: 50px;
      text-align: center;
    }

    .list-entry .entry-remove {
      background: none;
      border: none;
      color: var(--text-dim);
      cursor: pointer;
      padding: 2px 4px;
      font-size: 1rem;
      line-height: 1;
    }

    .list-entry .entry-remove:hover {
      color: var(--error);
    }

    /* Skill entry specific */
    .skill-entry .entry-name {
      font-size: 0.85rem;
    }

    /* Feat entry */
    .feat-entry input {
      flex: 1;
    }

    /* Weapon entry rows */
    .weapon-entry {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-xs);
      padding: var(--space-sm);
    }

    .weapon-entry .weapon-row {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      flex-wrap: wrap;
    }

    .weapon-entry .weapon-row input,
    .weapon-entry .weapon-row select {
      flex: 0 0 auto;
    }

    .weapon-entry .weapon-name {
      flex: 1;
      min-width: 100px;
    }

    .weapon-entry .weapon-damage {
      width: 60px;
    }

    .weapon-entry .weapon-type-sel {
      width: 50px;
    }

    .weapon-entry .weapon-pen {
      width: 50px;
    }

    .weapon-entry .weapon-range {
      width: 55px;
    }

    .weapon-entry .weapon-rof {
      width: 60px;
    }

    .weapon-entry .weapon-clip {
      width: 50px;
    }

    .weapon-entry .weapon-reload {
      width: 60px;
    }

    .weapon-entry .weapon-special {
      flex: 1;
      min-width: 80px;
    }

    /* Armor entry */
    .armor-entry {
      flex-wrap: wrap;
    }

    .armor-entry .armor-name {
      flex: 1;
      min-width: 100px;
    }

    .armor-entry .armor-ap {
      width: 50px;
      text-align: center;
    }

    .armor-entry .armor-locations {
      display: flex;
      gap: var(--space-xs);
      flex-wrap: wrap;
    }

    .armor-entry .armor-locations label {
      display: flex;
      align-items: center;
      gap: 2px;
      font-size: 0.75rem;
      margin: 0;
      cursor: pointer;
      color: var(--text-muted);
    }

    .armor-entry .armor-locations input[type="checkbox"] {
      width: auto;
      padding: 0;
      margin: 0;
    }

    /* Ability entry */
    .ability-entry {
      flex-direction: column;
      align-items: stretch;
    }

    .ability-entry .ability-header {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }

    .ability-entry .ability-name {
      flex: 1;
    }

    .ability-entry textarea {
      font-size: 0.85rem;
      padding: var(--space-xs);
      resize: vertical;
      min-height: 40px;
    }

    /* Traits Grid */
    .traits-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .trait-item {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-xs) var(--space-sm);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
    }

    .trait-item:hover {
      border-color: var(--border-light);
    }

    .trait-item.active {
      border-color: var(--accent);
      background: rgba(212, 168, 75, 0.08);
    }

    .trait-item input[type="checkbox"] {
      width: auto;
      margin: 0;
      accent-color: var(--accent);
    }

    .trait-item .trait-label {
      font-size: 0.85rem;
      font-weight: 500;
      flex: 1;
    }

    .trait-item .trait-param {
      width: 70px;
      padding: 2px var(--space-xs);
      font-size: 0.85rem;
      text-align: center;
    }

    .trait-item .trait-param-wide {
      width: 150px;
    }

    .trait-item .trait-effect {
      font-size: 0.7rem;
      color: var(--text-dim);
      display: none;
    }

    .trait-item.active .trait-effect {
      display: block;
    }

    /* Gear textarea */
    #gear-text {
      width: 100%;
      font-size: 0.85rem;
      padding: var(--space-sm);
      resize: vertical;
    }

    /* Preview Panel */
    .preview-panel {
      padding: var(--space-md) var(--space-lg);
      overflow-y: auto;
      max-height: calc(100vh - 50px);
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    /* Derived Stats Bar */
    .derived-bar {
      display: flex;
      gap: var(--space-md);
      padding: var(--space-sm) var(--space-md);
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      flex-wrap: wrap;
    }

    .derived-stat {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 50px;
    }

    .derived-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-dim);
    }

    .derived-value {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--accent);
    }

    /* Stat Card */
    .stat-card {
      background: var(--surface);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-lg);
      flex: 1;
    }

    .card-name {
      color: var(--accent);
      font-size: 1.4rem;
      margin: 0 0 var(--space-md);
      padding-bottom: var(--space-sm);
      border-bottom: 2px solid var(--accent-dim);
    }

    /* Char table in card */
    .char-table {
      margin: 0 0 var(--space-md);
      width: auto;
    }

    .char-table th,
    .char-table td {
      text-align: center;
      padding: var(--space-xs) var(--space-sm);
      min-width: 36px;
      font-size: 0.9rem;
    }

    .char-table th {
      font-size: 0.75rem;
      color: var(--text-muted);
      background: transparent;
      border-bottom: 1px solid var(--border);
    }

    .char-table td {
      font-weight: 700;
      border-bottom: none;
    }

    /* Card stats line */
    .card-stats {
      font-size: 0.9rem;
      margin-bottom: var(--space-md);
      color: var(--text);
      line-height: 1.8;
    }

    .card-stats strong {
      color: var(--accent);
    }

    /* Card body sections */
    .card-body {
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .card-body .card-line {
      margin-bottom: var(--space-xs);
    }

    .card-body .card-line-label {
      font-weight: 700;
      color: var(--text);
    }

    .card-body .card-ability {
      margin-left: var(--space-md);
      margin-bottom: var(--space-xs);
    }

    .card-body .card-ability-name {
      font-weight: 600;
      color: var(--accent);
    }

    /* Preview Actions */
    .preview-actions {
      display: flex;
      gap: var(--space-sm);
      padding-top: var(--space-sm);
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: var(--space-lg);
      left: 50%;
      transform: translateX(-50%);
      padding: var(--space-sm) var(--space-lg);
      background: var(--surface-raised);
      border: 1px solid var(--accent);
      border-radius: var(--radius-md);
      color: var(--text);
      font-size: 0.9rem;
      z-index: 1000;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }

    .toast.show {
      opacity: 1;
    }

    /* Responsive */
    @media (max-width: 800px) {
      .builder-layout {
        grid-template-columns: 1fr;
      }

      .input-panel {
        max-height: none;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }

      .preview-panel {
        max-height: none;
      }

      .top-bar {
        flex-wrap: wrap;
      }

      .top-bar-right {
        flex-wrap: wrap;
      }

      .core-fields {
        grid-template-columns: 1fr 1fr;
      }

      .field-wide {
        grid-column: 1 / -1;
      }
    }

    /* Print Styles */
    @media print {
      body {
        background: white;
        color: black;
      }

      .no-print {
        display: none !important;
      }

      .builder-layout {
        display: block;
      }

      .preview-panel {
        max-height: none;
        padding: 0;
      }

      .stat-card {
        border: 2px solid #333;
        background: white;
        page-break-inside: avoid;
        max-width: 600px;
      }

      .card-name {
        color: #333;
        border-bottom-color: #666;
      }

      .derived-value,
      .card-stats strong,
      .card-body .card-ability-name {
        color: #333;
      }

      .char-table th {
        color: #666;
      }
    }
  </style>
</ToolLayout>

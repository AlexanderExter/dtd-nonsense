---







import { NPCGeneratorApp } from "@/components/react/tools/npc-generator/NPCGeneratorApp";
import ToolLayout from "@/layouts/ToolLayout.astro";
---
<ToolLayout description="Manual stat block builder with auto-calculated derived stats, trait system, template loading, and printable output." title="NPC Stat Block Builder" >
  <NPCGeneratorApp client:only="react" />
  <style>
    @media print {
      body { color: black; background: white; }
      .no-print { display: none !important; }
      .stat-card { border: 2px solid #333; background: white; page-break-inside: avoid; max-width: 600px; }
    }
  </style>
</ToolLayout>

    // =========================================================================
    // Derived Stats Calculation
    // =========================================================================

    function calculateDerived() {
      const c = npc.characteristics;
      const size = npc.size;
      const level = npc.level;

      // Base calculations using imported derived module
      let sd = derived.calculateSD(c.dexterity, c.wisdom, size);
      let hp = derived.calculateHP(c.constitution, c.willpower);
      let mentalDef = derived.calculateMentalDefense(c.composure);
      let resilience = size;
      let aura = 0;
      let armorBonus = 0;

      // Apply trait effects
      const activeTraits = npc.traits;
      for (const traitRef of activeTraits) {
        const traitDef = traits.find(t => t.id === traitRef.id);
        if (!traitDef || !traitDef.derivedEffects) continue;

        const effects = traitDef.derivedEffects;

        // HP effects
        if (effects.hp === 'add_con') {
          hp += c.constitution;
        } else if (effects.hp === 'double') {
          hp *= 2;
        }

        // Resilience effects
        if (effects.resilience === 'add_con') {
          resilience += c.constitution;
        }

        // Armor effects
        if (effects.armor_all === 'param') {
          armorBonus += (typeof traitRef.param === 'number' ? traitRef.param : parseInt(traitRef.param, 10) || 0);
        } else if (effects.armor_all === 'add_con') {
          armorBonus += c.constitution;
        }

        // Aura
        if (effects.aura === 'param') {
          aura += (typeof traitRef.param === 'number' ? traitRef.param : parseInt(traitRef.param, 10) || 0);
        }
      }

      return { sd, hp, resilience, mentalDef, aura, armorBonus };
    }

    // =========================================================================
    // Update Preview
    // =========================================================================

    function update() {
      const d = calculateDerived();

      // Update derived stats bar
      document.getElementById('derived-sd').textContent = d.sd;
      document.getElementById('derived-hp').textContent = d.hp;
      document.getElementById('derived-resilience').textContent = d.resilience;
      document.getElementById('derived-mental').textContent = d.mentalDef;
      document.getElementById('derived-aura').textContent = d.aura;

      // Update stat card
      document.getElementById('card-name').textContent = npc.name || 'New NPC';

      // Char row
      const row = document.getElementById('card-char-row');
      const cells = row.querySelectorAll('td');
      CHAR_KEYS.forEach((key, i) => {
        const val = npc.characteristics[key];
        cells[i].textContent = val === 0 ? '-' : val;
      });

      // Stats line
      const statsDiv = document.getElementById('card-stats');
      statsDiv.innerHTML =
        `<strong>Speed:</strong> ${npc.speed}` +
        ` | <strong>Size/Resilience:</strong> ${npc.size}/${d.resilience}` +
        ` | <strong>SD:</strong> ${d.sd}` +
        ` | <strong>HP:</strong> ${d.hp}` +
        ` | <strong>Level:</strong> ${npc.level}`;

      // Body sections
      const bodyDiv = document.getElementById('card-body');
      let html = '';

      // Skills
      if (npc.skills.length) {
        html += `<div class="card-line"><span class="card-line-label">Skills:</span> ${npc.skills.map(s => `${s.name} ${s.dots}`).join(', ')}</div>`;
      }

      // Feats
      if (npc.feats.length) {
        html += `<div class="card-line"><span class="card-line-label">Feats:</span> ${npc.feats.join(', ')}</div>`;
      }

      // Armor
      if (npc.armor.length) {
        const armorStr = npc.armor.map(a => {
          const locs = a.locations.length ? a.locations.join(', ') : '';
          return `${a.name} (${a.ap} AP${locs ? '; ' + locs : ''})`;
        }).join(', ');
        html += `<div class="card-line"><span class="card-line-label">Armor:</span> ${armorStr}</div>`;
      } else {
        html += `<div class="card-line"><span class="card-line-label">Armor:</span> None</div>`;
      }

      // Weapons/Attacks
      if (npc.weapons.length) {
        const attackStr = npc.weapons.map(w => formatWeapon(w)).join(', ');
        html += `<div class="card-line"><span class="card-line-label">Attacks:</span> ${attackStr}</div>`;
      }

      // Abilities
      if (npc.abilities.length) {
        html += `<div class="card-line"><span class="card-line-label">Abilities:</span></div>`;
        for (const a of npc.abilities) {
          html += `<div class="card-ability">- <span class="card-ability-name">${escapeHtml(a.name)}</span>${a.description ? ' - ' + escapeHtml(a.description) : ''}</div>`;
        }
      }

      // Traits
      if (npc.traits.length) {
        const traitStr = npc.traits.map(t => {
          const def = traits.find(d => d.id === t.id);
          const name = def ? def.name : t.id;
          return t.param != null ? `${name} (${t.param})` : name;
        }).join(', ');
        html += `<div class="card-line"><span class="card-line-label">Traits:</span> ${traitStr}</div>`;
      }

      // Gear
      if (npc.gear) {
        html += `<div class="card-line"><span class="card-line-label">Gear:</span> ${escapeHtml(npc.gear)}</div>`;
      }

      bodyDiv.innerHTML = html;
    }

    function formatWeapon(w) {
      let s = escapeHtml(w.name);
      if (w.type === 'melee') {
        const parts = [];
        if (w.damage) parts.push(`${w.damage}${w.damageType ? ' ' + w.damageType : ''}`);
        if (w.pen) parts.push(`Pen ${w.pen}`);
        if (w.special) parts.push(w.special);
        if (parts.length) s += ` (${parts.join('; ')})`;
      } else {
        const parts = [];
        if (w.range) parts.push(`${w.range}m`);
        if (w.rof) parts.push(w.rof);
        if (w.damage) parts.push(`${w.damage}${w.damageType ? ' ' + w.damageType : ''}`);
        if (w.pen) parts.push(`Pen ${w.pen}`);
        if (w.clip != null && w.clip !== '') parts.push(`Clip ${w.clip}`);
        if (w.reload) parts.push(`Reload ${w.reload}`);
        if (w.special) parts.push(w.special);
        if (parts.length) s += ` (${parts.join('; ')})`;
      }
      return s;
    }

    // =========================================================================
    // Markdown Output
    // =========================================================================

    function generateMarkdown() {
      const d = calculateDerived();
      let md = '';

      md += `## ${npc.name || 'Unnamed NPC'}\n\n`;

      // Char table
      md += '| Str | Dex | Con | Cha | Fel | Cmp | Int | Wis | Wil |\n';
      md += '| :-: | :-: | :-: | :-: | :-: | :-: | :-: | :-: | :-: |\n';
      md += '|';
      for (const key of CHAR_KEYS) {
        const val = npc.characteristics[key];
        md += `  ${val === 0 ? '-' : val}  |`;
      }
      md += '\n\n';

      md += `**Speed:** ${npc.speed}\n`;
      md += `**Size/Resilience:** ${npc.size}/${d.resilience}\n`;
      md += `**Static Defense:** ${d.sd}\n`;
      md += `**HP:** ${d.hp}\n`;
      md += `**Level:** ${npc.level}\n\n`;

      if (npc.skills.length) {
        md += `**Skills:** ${npc.skills.map(s => `${s.name} ${s.dots}`).join(', ')}\n`;
      }

      if (npc.feats.length) {
        md += `**Feats:** ${npc.feats.join(', ')}\n`;
      } else {
        md += `**Feats:** None\n`;
      }

      if (npc.armor.length) {
        const armorStr = npc.armor.map(a => {
          const locs = a.locations.length ? a.locations.join(', ') : '';
          return `${a.name} (${a.ap} AP${locs ? '; ' + locs : ''})`;
        }).join(', ');
        md += `**Armor:** ${armorStr}\n`;
      } else {
        md += `**Armor:** None\n`;
      }

      if (npc.weapons.length) {
        md += `**Attacks:** ${npc.weapons.map(w => formatWeaponMd(w)).join(', ')}\n`;
      }

      if (npc.abilities.length) {
        md += `**Abilities:**\n\n`;
        for (const a of npc.abilities) {
          md += `- ${a.name}${a.description ? ' - ' + a.description : ''}\n`;
        }
        md += '\n';
      }

      if (npc.traits.length) {
        const traitStr = npc.traits.map(t => {
          const def = traits.find(d => d.id === t.id);
          const name = def ? def.name : t.id;
          return t.param != null ? `${name} (${t.param})` : name;
        }).join(', ');
        md += `**Traits:** ${traitStr}\n`;
      }

      if (npc.gear) {
        md += `**Gear:** ${npc.gear}\n`;
      }

      return md;
    }

    function formatWeaponMd(w) {
      let s = w.name;
      if (w.type === 'melee') {
        const parts = [];
        if (w.damage) parts.push(`${w.damage}${w.damageType ? ' ' + w.damageType : ''}`);
        if (w.pen) parts.push(`Pen ${w.pen}`);
        if (w.special) parts.push(w.special);
        if (parts.length) s += ` (${parts.join('; ')})`;
      } else {
        const parts = [];
        if (w.range) parts.push(`${w.range}m`);
        if (w.rof) parts.push(w.rof);
        if (w.damage) parts.push(`${w.damage}${w.damageType ? ' ' + w.damageType : ''}`);
        if (w.pen) parts.push(`Pen ${w.pen}`);
        if (w.clip != null && w.clip !== '') parts.push(`Clip ${w.clip}`);
        if (w.reload) parts.push(`Reload ${w.reload}`);
        if (w.special) parts.push(w.special);
        if (parts.length) s += ` (${parts.join('; ')})`;
      }
      return s;
    }

    async function copyMarkdown() {
      const md = generateMarkdown();
      try {
        await navigator.clipboard.writeText(md);
        showToast('Markdown copied to clipboard');
      } catch (_) {
        const ta = document.createElement('textarea');
        ta.value = md;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        showToast('Markdown copied to clipboard');
      }
    }

    // =========================================================================
    // Templates
    // =========================================================================

    function loadTemplate(tpl) {
      npc = {
        name: tpl.name,
        level: tpl.level,
        size: tpl.size,
        speed: tpl.speed,
        characteristics: { ...tpl.characteristics },
        skills: tpl.skills.map(s => ({ ...s })),
        feats: [...tpl.feats],
        traits: (tpl.traits || []).map(t => ({ ...t })),
        armor: (tpl.armor || []).map(a => ({ ...a, locations: [...a.locations] })),
        weapons: (tpl.weapons || []).map(w => ({ ...w })),
        abilities: (tpl.abilities || []).map(a => ({ ...a })),
        gear: Array.isArray(tpl.gear) ? tpl.gear.join(', ') : (tpl.gear || '')
      };
      loadNPCToForm();
      update();
      showToast(`Loaded: ${tpl.name}`);
    }

    // =========================================================================
    // Save / Load / Delete
    // =========================================================================

    function loadSavedList() {
      try {
        const raw = localStorage.getItem(STORAGE_LIST_KEY);
        savedList = raw ? JSON.parse(raw) : [];
      } catch (_) {
        savedList = [];
      }
    }

    function saveSavedList() {
      localStorage.setItem(STORAGE_LIST_KEY, JSON.stringify(savedList));
    }

    function saveNPC() {
      readFormToState();
      const id = npc.name ? npc.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '') : 'npc-' + Date.now();

      localStorage.setItem(STORAGE_PREFIX + id, JSON.stringify(npc));

      if (!savedList.includes(id)) {
        savedList.push(id);
        saveSavedList();
      }

      buildSavedDropdown();
      document.getElementById('saved-select').value = id;
      showToast(`Saved: ${npc.name || id}`);
    }

    function loadSavedNPC(id) {
      const raw = localStorage.getItem(STORAGE_PREFIX + id);
      if (!raw) return;
      try {
        const data = JSON.parse(raw);
        npc = { ...createDefaultNPC(), ...data };
        loadNPCToForm();
        update();
        showToast(`Loaded: ${npc.name || id}`);
      } catch (_) {
        showToast('Failed to load NPC');
      }
    }

    function deleteSavedNPC() {
      const sel = document.getElementById('saved-select');
      const id = sel.value;
      if (!id) {
        showToast('Select a saved NPC to delete');
        return;
      }

      localStorage.removeItem(STORAGE_PREFIX + id);
      savedList = savedList.filter(i => i !== id);
      saveSavedList();
      buildSavedDropdown();
      showToast('Deleted saved NPC');
    }

    function duplicateNPC() {
      readFormToState();
      npc.name = (npc.name || 'NPC') + ' (Copy)';
      loadNPCToForm();
      update();
      showToast('Duplicated \u2014 edit and save as new');
    }

    // =========================================================================
    // Toast
    // =========================================================================

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.hidden = false;
      el.classList.add('show');
      clearTimeout(_toastTimer);
      _toastTimer = setTimeout(() => {
        el.classList.remove('show');
        setTimeout(() => { el.hidden = true; }, 300);
      }, 2000);
    }
  </script>

  <style>
    /* NPC Stat Block Builder — Layout & Components */


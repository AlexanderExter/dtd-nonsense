---
// ToolLayout — wraps tool pages within a Starlight-compatible shell.
// Provides consistent header/nav while letting tools render client-side.
import Analytics from "@vercel/analytics/astro";
import "@/styles/tailwind.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — DTD 40k Tools</title>
    <meta name="description" content={description} />

    <!-- Starlight theme vars (loaded from our custom CSS) -->
    <Analytics />
  </head>
  <body class="m-0 p-0 font-sans text-base leading-relaxed text-text-primary bg-bg min-h-screen">
    <header class="bg-surface border-b border-border py-3 px-lg">
      <div class="flex items-center gap-8 max-w-[1400px] mx-auto">
        <a href="/" class="font-bold text-lg !text-accent whitespace-nowrap">DTD 40k</a>
        <nav class="flex gap-5 flex-wrap">
          <a href="/tools/" class="text-text-muted text-sm transition-colors duration-150 hover:text-accent">Tools</a>
          <a href="/rules/01-core-rules/" class="text-text-muted text-sm transition-colors duration-150 hover:text-accent">Rules</a>
          <a href="/tools/dice-roller/" class="text-text-muted text-sm transition-colors duration-150 hover:text-accent">Dice Roller</a>
          <a href="/tools/character-builder/" class="text-text-muted text-sm transition-colors duration-150 hover:text-accent">Builder</a>
          <a href="/tools/character-sheet/" class="text-text-muted text-sm transition-colors duration-150 hover:text-accent">Sheet</a>
          <a href="/tools/combat-tracker/" class="text-text-muted text-sm transition-colors duration-150 hover:text-accent">Combat</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="text-center p-lg text-text-dim text-sm border-t border-border mt-xl">
      <p class="m-0">
        Fan-made tools for <em>Dungeons the Dragoning 40,000: 7th Edition</em>.
        All content belongs to its respective creators.
      </p>
    </footer>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
    </style>
  </body>
</html>
